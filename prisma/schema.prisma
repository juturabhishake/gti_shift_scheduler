generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AccessTypes {
  id          Int    @id(map: "PK_AccessTypes") @default(autoincrement())
  access_type String @db.VarChar(50)
}

model Categories {
  Id            Int             @id(map: "PK__Categori__3214EC07182768A9") @default(autoincrement())
  Name          String          @db.NVarChar(255)
  TeamId        Int
  Teams         Teams           @relation(fields: [TeamId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK__Categorie__TeamI__245D67DE")
  Subcategories Subcategories[]
}

model Departments {
  Id       Int        @id(map: "PK__Departme__3214EC074F938E44") @default(autoincrement())
  Name     String     @db.NVarChar(255)
  GroupId  Int
  Groups   Groups     @relation(fields: [GroupId], references: [Id], onUpdate: NoAction, map: "FK__Departmen__Group__7C4F7684")
  Sections Sections[]
  Teams    Teams[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ErrorLogs {
  ID         Int     @default(autoincrement())
  ErrorValue String? @db.VarChar(Max)
  ERRORMSG   String? @db.VarChar(Max)

  @@ignore
}

model Groups {
  Id          Int           @id(map: "PK__Groups__3214EC0738386975") @default(autoincrement())
  Name        String        @unique(map: "UQ__Groups__737584F6545E7863") @db.NVarChar(255)
  Departments Departments[]
  Sections    Sections[]
  Teams       Teams[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model M_Department {
  DeptID     Int     @default(autoincrement())
  Department String  @db.VarChar(50)
  Section    String  @db.VarChar(50)
  Active     String? @default("Y", map: "DF__M_Departm__Activ__49C3F6B7") @db.Char(1)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model PageRoleAccess {
  id      Int     @default(autoincrement())
  empId   String? @db.VarChar(255)
  page_id Int?
  access  Int?

  @@ignore
}

model Pages {
  id           Int     @id(map: "PK_Pages") @default(autoincrement())
  page         String? @db.VarChar(Max)
  url          String? @db.VarChar(Max)
  access_types String? @db.VarChar(Max)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Params {
  Id       Int     @default(autoincrement())
  SP_Name  String? @db.VarChar(200)
  XMLValue String? @db.Xml

  @@ignore
}

model ProductMatrix {
  Product_Id        Int       @id(map: "PK_ProductMatrix") @default(autoincrement())
  Project           String?   @db.VarChar(255)
  Status            String?   @db.VarChar(20)
  Customer          String?   @db.VarChar(255)
  CustLocation      String?   @db.VarChar(255)
  CustCity          String?   @db.VarChar(255)
  WHLocation        String?   @db.VarChar(255)
  DeliveryLoc       String?   @db.VarChar(255)
  PartDesc          String?   @db.VarChar(255)
  CastRR            Int?
  MachRR            Int?
  AssyRR            Int?
  Location          String?   @db.VarChar(255)
  Cast_PartNo       String?   @db.VarChar(255)
  Cast_Dwg_Rev      String?   @db.VarChar(5)
  Cast_Part_Rev     String?   @db.VarChar(5)
  Cast_Wt           Float?
  Cast_Appr         String?   @db.VarChar(10)
  Mach_PartNo       String?   @db.VarChar(255)
  Mach_Dwg_Rev      String?   @db.VarChar(5)
  Mach_Part_Rev     String?   @db.VarChar(5)
  Mach_Wt           Float?
  Mach_Appr         String?   @db.VarChar(10)
  Assy_PartNo       String?   @db.VarChar(255)
  Assy_Dwg_Rev      String?   @db.VarChar(5)
  Assy_Part_Rev     String?   @db.VarChar(5)
  Assy_Wt           Float?
  Assy_Appr         String?   @db.VarChar(10)
  Ship_PartNo       String?   @db.VarChar(255)
  HS_PartNo         String?   @db.VarChar(255)
  Proj_Status       String?   @db.VarChar(10)
  SOP_Date          DateTime? @db.DateTime
  Pmpd              String?   @db.VarChar(50)
  Saletype          String?   @db.VarChar(5)
  InstallCapa       Int?
  Boxqty            Int?
  Material          String?   @db.VarChar(255)
  Matl_Rev          String?   @db.VarChar(255)
  Cust_Material     String?   @db.VarChar(50)
  Cust_Material_Rev String?   @db.VarChar(10)
  Pkg_Wt            Decimal?  @db.Decimal(18, 3)
  CreatedDate       DateTime? @default(now(), map: "CDF_Date") @db.DateTime
  CreatedBy         String?   @db.VarChar(10)
  UpdatedDate       DateTime? @db.DateTime
  UpdatedBy         String?   @db.VarChar(10)
}

model Sections {
  Id          Int         @id(map: "PK__Sections__3214EC075EAFA74F") @default(autoincrement())
  Name        String      @db.NVarChar(255)
  DeptId      Int
  GroupId     Int?
  Departments Departments @relation(fields: [DeptId], references: [Id], onUpdate: NoAction, map: "FK__Sections__DeptId__00200768")
  Groups      Groups?     @relation(fields: [GroupId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Sections_GroupId")
  Teams       Teams[]
}

model Shifts {
  Id    Int    @id(map: "PK__Shifts__3214EC079E7F2C09") @default(autoincrement())
  Name  String @unique(map: "UQ__Shifts__737584F69E02FCDF") @db.NVarChar(50)
  Hours Float  @default(8.0, map: "DF__Shifts__Hours__4D5F7D71")
}

model ShopLocations {
  ShopID       Int    @id(map: "PK__ShopLoca__67C556299E1EBB23") @default(autoincrement())
  LocationName String @db.VarChar(100)
}

model Subcategories {
  Id            Int        @id(map: "PK__Subcateg__3214EC0779644CD1") @default(autoincrement())
  Name          String     @db.NVarChar(255)
  StandardHours Float      @default(0, map: "DF__Subcatego__Stand__2739D489")
  CategoryId    Int
  CreatedDate   DateTime   @default(now(), map: "DF__Subcatego__Creat__3C34F16F") @db.DateTime
  Project       String?    @db.NVarChar(255)
  MaxHours      Float?
  MediumHours   Float?
  MinHours      Float?
  Categories    Categories @relation(fields: [CategoryId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK__Subcatego__Categ__282DF8C2")
}

model TaskAssignment {
  Id                  Int       @id(map: "PK__TaskAssi__3214EC07B2ECA664") @default(autoincrement())
  SubcategoryId       Int
  AssignedUserId      Int?
  ActualHours         Float?
  StatusId            Int?
  Reason              String?   @db.NVarChar(Max)
  TaskDetails         String?   @db.NVarChar(Max)
  WorkDate            DateTime? @db.DateTime
  DueDate             DateTime? @db.DateTime
  Severity            String?   @db.NVarChar(50)
  TargetStandardHours Float?
  ProgressPct         Int?      @default(0, map: "DF__TaskAssig__Progr__531856C7")
}

model TaskStatusMaster {
  Id         Int    @id(map: "PK__TaskStat__3214EC078E50BDEE") @default(autoincrement())
  StatusName String @db.NVarChar(50)
}

model Teams {
  Id          Int          @id(map: "PK__Teams__3214EC071F092FCC") @default(autoincrement())
  Name        String       @db.NVarChar(255)
  SectionId   Int
  GroupId     Int?
  DeptId      Int?
  Categories  Categories[]
  Sections    Sections     @relation(fields: [SectionId], references: [Id], onUpdate: NoAction, map: "FK__Teams__SectionId__03F0984C")
  Departments Departments? @relation(fields: [DeptId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Teams_DeptId")
  Groups      Groups?      @relation(fields: [GroupId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Teams_GroupId")
}

model UserHierarchyMap {
  Id         Int        @id(map: "PK__UserHier__3214EC07F9BE46D2") @default(autoincrement())
  UserId     Int
  GroupId    Int?
  DeptId     Int?
  SectionId  Int?
  TeamId     Int?
  ShiftId    Int?
  UserMaster UserMaster @relation(fields: [UserId], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "FK__UserHiera__UserI__2180FB33")
}

model UserMaster {
  UserID           Int                @id(map: "PK_UserMaster") @default(autoincrement())
  EmployeeId       String             @db.VarChar(10)
  Username         String             @db.VarChar(200)
  Password         String             @db.NVarChar(200)
  CreatedDate      DateTime           @default(now(), map: "DF_UserMaster_CreatedDate") @db.DateTime
  CreatedBy        String?            @db.VarChar(200)
  IsActive         Int                @default(1, map: "DF_UserMaster_IsActive")
  AuthMode         String?            @db.VarChar(50)
  Department       String?            @db.NVarChar(50)
  Position         String?            @db.NVarChar(50)
  Section          String?            @db.VarChar(50)
  Designation      String?            @db.VarChar(Max)
  UserHierarchyMap UserHierarchyMap[]
}
